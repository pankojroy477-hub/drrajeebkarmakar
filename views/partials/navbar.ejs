<header id="site-header" class="site-header sticky top-0 z-50 bg-[#071B49]/95 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Doctor Title -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#25C5E8] rounded-lg p-1" aria-label="Home - Dr. Rajeeebshankar Karmakar">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#1677D2] to-[#25C5E8] flex items-center justify-center text-white shadow-lg shadow-[#1677D2]/25 group-hover:scale-105 transition-transform duration-200">
          <!-- Medical Caduceus / Lungs Stylized SVG -->
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M7 5a4 4 0 0 1 4 4v11M17 5a4 4 0 0 0-4 4v11"/>
            <path d="M7 10c-2.5 0-4.5 2-4.5 4.5S4.5 19 7 19h1M17 10c2.5 0 4.5 2 4.5 4.5S19.5 19 17 19h-1"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-white font-bold text-lg leading-tight tracking-tight font-display">
            <span class="lang-text" data-en="Dr. Rajeeebshankar Karmakar" data-bn="ডা. রাজীবশঙ্কর কর্মকার">ডা. রাজীবশঙ্কর কর্মকার</span>
          </span>
          <span class="text-[#25C5E8] text-xs font-medium tracking-wide">
            <span class="lang-text" data-en="Assistant Professor (Thoracic Surgery)" data-bn="সহকারী অধ্যাপক (থোরাসিক সার্জারি)">সহকারী অধ্যাপক (থোরাসিক সার্জারি)</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>" aria-current="<%= currentPath === '/' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="Home" data-bn="মূলপাতা">মূলপাতা</span>
        </a>
        <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>" aria-current="<%= currentPath === '/about' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="About" data-bn="পরিচিতি">পরিচিতি</span>
        </a>
        <a href="/expertise" class="nav-link <%= currentPath === '/expertise' ? 'active' : '' %>" aria-current="<%= currentPath === '/expertise' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="Expertise" data-bn="চিকিৎসা ও সার্জারি">চিকিৎসা ও সার্জারি</span>
        </a>
        <a href="/chambers" class="nav-link <%= currentPath === '/chambers' ? 'active' : '' %>" aria-current="<%= currentPath === '/chambers' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="Chambers" data-bn="চেম্বার ও সময়সূচি">চেম্বার ও সময়সূচি</span>
        </a>
        <a href="/publications" class="nav-link <%= currentPath === '/publications' ? 'active' : '' %>" aria-current="<%= currentPath === '/publications' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="Publications" data-bn="গবেষণা">গবেষণা</span>
        </a>
        <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>" aria-current="<%= currentPath === '/contact' ? 'page' : 'false' %>">
          <span class="lang-text" data-en="Contact" data-bn="যোগাযোগ">যোগাযোগ</span>
        </a>
      </nav>

      <!-- Language Switcher & Appointment CTA -->
      <div class="hidden lg:flex items-center gap-4">
        
        <!-- Language Switcher Button -->
        <button id="lang-toggle-btn" type="button" class="lang-toggle-pill flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/20 bg-white/5 text-white text-xs font-semibold hover:bg-white/10 transition-all focus:outline-none focus:ring-2 focus:ring-[#25C5E8]" aria-label="Switch Language / ভাষা পরিবর্তন">
          <svg class="w-3.5 h-3.5 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="2"/>
            <path stroke-width="2" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span id="lang-btn-label">বাংলা | EN</span>
        </button>

        <!-- Direct Appointment CTA Button -->
        <a href="/contact#appointment" class="btn-primary-gradient shadow-md shadow-[#1677D2]/30 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="lang-text" data-en="Book Serial" data-bn="সিরিয়াল নিন">সিরিয়াল নিন</span>
        </a>
      </div>

      <!-- Mobile Menu Hamburger & Mobile Lang Toggle -->
      <div class="flex items-center gap-2.5 lg:hidden">
        <!-- Mobile Lang Toggle -->
        <button id="mobile-lang-toggle" type="button" class="px-2.5 py-1 rounded-full border border-white/20 text-white text-xs font-semibold bg-white/10" aria-label="Toggle language">
          <span id="mobile-lang-label">বাংলা / EN</span>
        </button>

        <!-- Hamburger Button -->
        <button id="mobile-menu-toggle" type="button" class="w-10 h-10 flex items-center justify-center text-white rounded-lg hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#25C5E8]" aria-controls="mobile-drawer" aria-expanded="false" aria-label="Open navigation menu">
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Slide-out Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer hidden lg:hidden bg-[#071B49] border-b border-white/10 px-4 pt-3 pb-6 transition-all duration-300">
    <nav class="flex flex-col space-y-2" aria-label="Mobile Navigation">
      <a href="/" class="mobile-nav-link <%= currentPath === '/' ? 'active' : '' %>">
        <span class="lang-text" data-en="Home" data-bn="মূলপাতা">মূলপাতা</span>
      </a>
      <a href="/about" class="mobile-nav-link <%= currentPath === '/about' ? 'active' : '' %>">
        <span class="lang-text" data-en="About Doctor" data-bn="ডাক্তার পরিচিতি">ডাক্তার পরিচিতি</span>
      </a>
      <a href="/expertise" class="mobile-nav-link <%= currentPath === '/expertise' ? 'active' : '' %>">
        <span class="lang-text" data-en="Specialties & Procedures" data-bn="চিকিৎসা ও সার্জারি">চিকিৎসা ও সার্জারি</span>
      </a>
      <a href="/chambers" class="mobile-nav-link <%= currentPath === '/chambers' ? 'active' : '' %>">
        <span class="lang-text" data-en="Chambers & Visiting Hours" data-bn="চেম্বার ও সময়সূচি">চেম্বার ও সময়সূচি</span>
      </a>
      <a href="/publications" class="mobile-nav-link <%= currentPath === '/publications' ? 'active' : '' %>">
        <span class="lang-text" data-en="Research Publications (13)" data-bn="গবেষণা ও প্রকাশনা (১৩)">গবেষণা ও প্রকাশনা (১৩)</span>
      </a>
      <a href="/contact" class="mobile-nav-link <%= currentPath === '/contact' ? 'active' : '' %>">
        <span class="lang-text" data-en="Contact & Appointment" data-bn="যোগাযোগ ও অ্যাপয়েন্টমেন্ট">যোগাযোগ ও অ্যাপয়েন্টমেন্ট</span>
      </a>
      
      <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
        <a href="tel:01944648809" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-white/10 text-white font-medium text-sm hover:bg-white/20">
          <svg class="w-4 h-4 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>01944648809</span>
        </a>
        <a href="/contact#appointment" class="btn-primary-gradient w-full text-center py-2.5 text-sm font-semibold rounded-xl">
          <span class="lang-text" data-en="Request Chamber Serial" data-bn="চেম্বার সিরিয়াল বুক করুন">চেম্বার সিরিয়াল বুক করুন</span>
        </a>
      </div>
    </nav>
  </div>
</header>
