<!-- ==========================================
     PAGE HEADER
     ========================================== -->
<div class="bg-[#071B49] text-white py-12 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2 text-xs text-[#25C5E8] mb-3">
      <a href="/" class="hover:underline">Home / মূলপাতা</a>
      <span>/</span>
      <span class="text-white">Chambers / চেম্বার</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
      <span class="lang-text" data-en="Chambers & Visiting Hours" data-bn="চেম্বার ও রোগী দেখার সময়সূচি">চেম্বার ও রোগী দেখার সময়সূচি</span>
    </h1>
    <p class="text-sm sm:text-base text-white/80 mt-2 max-w-3xl">
      <span class="lang-text" 
        data-en="Consult Dr. Rajeeebshankar Karmakar in Faridpur and Madaripur. Check verified visiting days, hours, and serial booking contacts." 
        data-bn="ফরিদপুর ও মাদারীপুর চেম্বারে ডা. রাজীবশঙ্কর কর্মকারের নিয়মিত রোগী দেখার দিন, সময় ও সিরিয়াল যোগাযোগের তথ্য।">
        ফরিদপুর ও মাদারীপুর চেম্বারে ডা. রাজীবশঙ্কর কর্মকারের নিয়মিত রোগী দেখার দিন, সময় ও সিরিয়াল যোগাযোগের তথ্য।
      </span>
    </p>
  </div>
</div>

<!-- ==========================================
     CHAMBER DETAILS
     ========================================== -->
<section class="py-16 bg-[#F1F5FA] border-b border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <% chambers.forEach((ch, idx) => { %>
        <div class="chamber-card">
          
          <!-- Top Badge & Header -->
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <span class="chamber-badge mb-2">
                <svg class="w-3.5 h-3.5 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                <span>Chamber <%= idx + 1 %></span>
              </span>
              <h2 class="text-2xl font-extrabold text-[#071B49]">
                <span class="lang-text" data-en="<%= ch.hospitalEn %>" data-bn="<%= ch.hospitalBn %>"><%= ch.hospitalBn %></span>
              </h2>
            </div>
            
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#1677D2] flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
          </div>

          <!-- Address & Timing -->
          <div class="space-y-4 mb-6 flex-grow">
            
            <div class="flex items-start gap-3 text-sm text-[#15233F]">
              <div class="w-7 h-7 rounded-lg bg-white border border-[#CBD5E1] flex items-center justify-center text-[#1677D2] flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-[#5A6A85] uppercase">
                  <span class="lang-text" data-en="Location & Address" data-bn="চেম্বারের পূর্ণ ঠিকানা">চেম্বারের পূর্ণ ঠিকানা</span>
                </p>
                <p class="font-medium text-sm leading-relaxed mt-0.5">
                  <span class="lang-text" data-en="<%= ch.locationEn %>" data-bn="<%= ch.locationBn %>"><%= ch.locationBn %></span>
                </p>
              </div>
            </div>

            <!-- Visiting Schedule -->
            <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#CBD5E1] space-y-2">
              <div class="flex items-center gap-2.5 text-sm font-bold text-[#071B49]">
                <svg class="w-4 h-4 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>
                  <span class="lang-text" data-en="Visiting Day:" data-bn="রোগী দেখার দিন:">রোগী দেখার দিন:</span>
                  <span class="text-[#1677D2] ml-1">
                    <span class="lang-text" data-en="<%= ch.visitingDayEn %>" data-bn="<%= ch.visitingDayBn %>"><%= ch.visitingDayBn %></span>
                  </span>
                </span>
              </div>
              <div class="flex items-center gap-2.5 text-sm font-bold text-[#13A89E]">
                <svg class="w-4 h-4 text-[#13A89E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>
                  <span class="lang-text" data-en="Visiting Hours:" data-bn="রোগী দেখার সময়:">রোগী দেখার সময়:</span>
                  <span class="text-[#071B49] ml-1">
                    <span class="lang-text" data-en="<%= ch.visitingTimeEn %>" data-bn="<%= ch.visitingTimeBn %>"><%= ch.visitingTimeBn %></span>
                  </span>
                </span>
              </div>
            </div>

            <!-- Serial Phone -->
            <div class="flex items-center gap-3 p-3 rounded-xl bg-blue-50/60 border border-blue-100">
              <svg class="w-5 h-5 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div>
                <p class="text-[11px] text-[#5A6A85] font-semibold">
                  <span class="lang-text" data-en="Chamber Serial Phone" data-bn="সিরিয়াল বুকিং নম্বর">সিরিয়াল বুকিং নম্বর</span>
                </p>
                <p class="text-base font-bold text-[#071B49]">01944648809</p>
              </div>
            </div>

            <% if (ch.notesEn) { %>
              <p class="text-xs text-[#5A6A85] italic">
                <span class="lang-text" data-en="* <%= ch.notesEn %>" data-bn="* <%= ch.notesBn %>">* <%= ch.notesBn %></span>
              </p>
            <% } %>

          </div>

          <!-- Action Buttons -->
          <div class="pt-4 border-t border-[#E2E8F0] grid grid-cols-2 sm:grid-cols-3 gap-2">
            <a href="tel:<%= ch.appointmentPhone %>" class="btn-primary-gradient text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1.5 rounded-xl">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span class="lang-text" data-en="Call Serial" data-bn="সিরিয়াল কল">সিরিয়াল কল</span>
            </a>

            <a href="https://wa.me/<%= ch.whatsappNumber %>?text=<%= encodeURIComponent('হ্যালো, আমি ' + ch.hospitalBn + ' চেম্বারে ডা. রাজীবশঙ্কর কর্মকারের সিরিয়ালের জন্য যোগাযোগ করছি।') %>" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1.5 rounded-xl border-teal-500 text-teal-700 hover:bg-teal-50">
              <svg class="w-3.5 h-3.5 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.969.585 1.961.948 3.226.949h.005c3.18 0 5.768-2.586 5.769-5.767.001-1.542-.599-2.991-1.688-4.081-1.09-1.09-2.539-1.69-4.08-1.69zm8.563 5.768c-.002 4.71-3.834 8.541-8.547 8.541-1.442 0-2.85-.365-4.1-1.057l-4.57 1.198 1.22-4.453c-.76-1.321-1.161-2.827-1.16-4.229.002-4.711 3.834-8.542 8.548-8.542 2.283.001 4.43 1.033 6.044 2.648 1.615 1.616 2.503 3.762 2.501 6.044z"/>
              </svg>
              <span>WhatsApp</span>
            </a>

            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(ch.googleMapsQuery) %>" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1 rounded-xl col-span-2 sm:col-span-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              <span class="lang-text" data-en="Map Directions" data-bn="গুগল ম্যাপ">গুগল ম্যাপ</span>
            </a>
          </div>

        </div>
      <% }); %>
    </div>

    <!-- Important Patient Visiting Notice -->
    <div class="med-card max-w-3xl mx-auto p-6 bg-white border-blue-200">
      <h3 class="font-bold text-base text-[#071B49] mb-2 flex items-center gap-2">
        <svg class="w-5 h-5 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="lang-text" data-en="Patient Visit Instructions" data-bn="চেম্বারে সাক্ষাতের পরামর্শ">চেম্বারে সাক্ষাতের পরামর্শ</span>
      </h3>
      <ul class="text-xs sm:text-sm text-[#5A6A85] space-y-1.5 list-disc pl-5">
        <li>
          <span class="lang-text" data-en="Advance serial booking over phone or WhatsApp is strongly advised to avoid waiting." data-bn="অহেতুক বিলম্ব এড়াতে আগে থেকে ফোন বা হোয়াটসঅ্যাপে সিরিয়াল বুক করে রাখার পরামর্শ দেওয়া হচ্ছে।">অহেতুক বিলম্ব এড়াতে আগে থেকে ফোন বা হোয়াটসঅ্যাপে সিরিয়াল বুক করে রাখার পরামর্শ দেওয়া হচ্ছে।</span>
        </li>
        <li>
          <span class="lang-text" data-en="Please bring previous chest X-rays, CT scan plates, sputum test results, and all ongoing medicine prescriptions." data-bn="রোগীর পূর্ববর্তী বুকের এক্স-রে, সিটি স্ক্যানের ফিল্ম, কফ পরীক্ষার রিপোর্ট এবং চলমান প্রেসক্রিপশন সাথে আনুন।">রোগীর পূর্ববর্তী বুকের এক্স-রে, সিটি স্ক্যানের ফিল্ম, কফ পরীক্ষার রিপোর্ট এবং চলমান প্রেসক্রিপশন সাথে আনুন।</span>
        </li>
      </ul>
    </div>

  </div>
</section>
