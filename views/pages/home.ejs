<!-- ==========================================
     HERO SECTION
     ========================================== -->
<section class="hero-section" aria-label="Introduction">
  <div class="hero-glow-blob top-10 right-10"></div>
  <div class="hero-glow-blob bottom-10 left-10 opacity-60"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Hero Column: Doctor Intro -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Specialty Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-[#25C5E8] animate-pulse"></span>
          <span class="text-[#25C5E8] text-xs sm:text-sm font-semibold tracking-wide">
            <span class="lang-text" 
              data-en="Chest Specialist & Surgical Pulmonologist" 
              data-bn="বক্ষব্যাধি বিশেষজ্ঞ ও সার্জিক্যাল পালমোনোলজিস্ট">
              বক্ষব্যাধি বিশেষজ্ঞ ও সার্জিক্যাল পালমোনোলজিস্ট
            </span>
          </span>
        </div>

        <!-- Doctor Name -->
        <div class="hero-headline space-y-2">
          <h1 class="text-3xl sm:text-5xl lg:text-5xl font-black text-white tracking-tight leading-[1.15]">
            <span class="lang-text" data-en="Dr. Rajeeebshankar Karmakar" data-bn="ডা. রাজীবশঙ্কর কর্মকার">ডা. রাজীবশঙ্কর কর্মকার</span>
          </h1>
          <p class="text-xl sm:text-2xl font-bold text-[#25C5E8]">
            <span class="lang-text" data-en="Assistant Professor (Thoracic Surgery)" data-bn="সহকারী অধ্যাপক (থোরাসিক সার্জারি)">সহকারী অধ্যাপক (থোরাসিক সার্জারি)</span>
          </p>
          <p class="text-base sm:text-lg text-white/90 font-medium">
            <span class="lang-text" data-en="Consultant, Thoracic & Oesophageal Surgeon" data-bn="কনসালটেন্ট, থোরাসিক ও খাদ্যনালী সার্জন">কনসালটেন্ট, থোরাসিক ও খাদ্যনালী সার্জন</span>
          </p>
          <p class="text-sm text-white/75">
            <span class="lang-text" data-en="Faridpur Medical College Hospital, Faridpur, Bangladesh" data-bn="ফরিদপুর মেডিকেল কলেজ হাসপাতাল, ফরিদপুর, বাংলাদেশ">ফরিদপুর মেডিকেল কলেজ হাসপাতাল, ফরিদপুর, বাংলাদেশ</span>
          </p>
        </div>

        <!-- Tagline & Brief Intro -->
        <div class="hero-sub space-y-4">
          <blockquote class="border-l-4 border-[#25C5E8] pl-4 py-1 italic text-white/90 text-base sm:text-lg font-medium">
            <span class="lang-text" data-en="&ldquo;Expert Care for Healthy Lungs & Better Life&rdquo;" data-bn="&ldquo;সুস্থ ফুসফুস, স্বস্তির নিঃশ্বাস, উন্নত জীবন&rdquo;">&ldquo;সুস্থ ফুসফুস, স্বস্তির নিঃশ্বাস, উন্নত জীবন&rdquo;</span>
          </blockquote>

          <p class="text-white/80 text-sm sm:text-base leading-relaxed max-w-2xl">
            <span class="lang-text" 
              data-en="<%= doctor.bioSummaryEn %>" 
              data-bn="<%= doctor.bioSummaryBn %>">
              <%= doctor.bioSummaryBn %>
            </span>
          </p>

          <!-- Verified Credentials Bar -->
          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-white/70">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-white/10">
              <svg class="w-3.5 h-3.5 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>BMDC: <strong>A-61665</strong></span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-white/10">
              <svg class="w-3.5 h-3.5 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span><strong>12+</strong> Years Clinical Experience</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/5 border border-white/10">
              <svg class="w-3.5 h-3.5 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <span>NIDCH, MS (Thoracic Surgery)</span>
            </span>
          </div>
        </div>

        <!-- Primary Action CTAs -->
        <div class="hero-ctas flex flex-wrap items-center gap-4 pt-2">
          <a href="#appointment" class="btn-cyan-accent text-sm sm:text-base px-6 py-3.5 shadow-lg shadow-[#25C5E8]/25 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#071B49]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="lang-text" data-en="Request Chamber Serial" data-bn="চেম্বার সিরিয়াল বুক করুন">চেম্বার সিরিয়াল বুক করুন</span>
          </a>

          <a href="/expertise" class="btn-white-outline text-sm sm:text-base px-5 py-3.5 flex items-center gap-2">
            <span class="lang-text" data-en="Clinical Specialties" data-bn="বিশেষজ্ঞ চিকিৎসাসমূহ">বিশেষজ্ঞ চিকিৎসাসমূহ</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a href="tel:01944648809" class="inline-flex items-center gap-2 text-white/90 hover:text-[#25C5E8] text-sm font-semibold transition-colors py-2 px-3">
            <svg class="w-4 h-4 text-[#25C5E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>01944648809</span>
          </a>
        </div>

      </div>

      <!-- Right Hero Column: Refined Portrait & Anatomical Artwork -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="doctor-portrait-card w-full max-w-md relative group">
          
          <!-- Background Respiratory SVG Illustration -->
          <div class="absolute -top-12 -right-12 w-48 h-48 opacity-25 pointer-events-none">
            <img src="/images/medical/lungs-illustration.svg" alt="" aria-hidden="true" class="w-full h-full object-contain" />
          </div>

          <!-- Doctor Portrait Frame -->
          <div class="doctor-portrait-inner aspect-[4/5] w-full">
            <img 
              src="/images/doctor/doctor-portrait.svg" 
              alt="Dr. Rajeeebshankar Karmakar - Assistant Professor (Thoracic Surgery)" 
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-102"
              loading="eager"
            />
          </div>

          <!-- Quick Chamber Summary Badge Over Portrait Card -->
          <div class="mt-4 p-3 rounded-xl bg-white/10 border border-white/10 backdrop-blur-md flex items-center justify-between text-xs text-white">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#13A89E]"></span>
              <span class="font-semibold">
                <span class="lang-text" data-en="2 Active Chamber Locations" data-bn="২টি নিয়মিত চেম্বার">২টি নিয়মিত চেম্বার</span>
              </span>
            </div>
            <a href="/chambers" class="text-[#25C5E8] hover:underline font-bold flex items-center gap-1">
              <span class="lang-text" data-en="View Hours" data-bn="সময়সূচি দেখুন">সময়সূচি দেখুন</span>
              <span>›</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ==========================================
     EMERGENCY NOTICE BANNER
     ========================================== -->
<section class="bg-gradient-to-r from-red-600/10 via-amber-500/10 to-red-600/10 border-y border-red-200/60 py-4 px-4" aria-label="Emergency Medical Advisory">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center gap-3 text-sm text-[#071B49]">
    <div class="flex items-center gap-2 flex-shrink-0 font-bold text-red-700">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <span class="lang-text" data-en="EMERGENCY NOTICE:" data-bn="জরুরি সতর্কতা:">জরুরি সতর্কতা:</span>
    </div>
    <p class="text-xs sm:text-sm leading-relaxed text-[#15233F]/90">
      <span class="lang-text" 
        data-en="<%= emergencyNotice.messageEn %>" 
        data-bn="<%= emergencyNotice.messageBn %>">
        <%= emergencyNotice.messageBn %>
      </span>
    </p>
  </div>
</section>

<!-- ==========================================
     VERIFIED TRUST & STATISTICS
     ========================================== -->
<section id="statistics-section" class="py-12 bg-white border-b border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      
      <!-- Stat 1: Experience -->
      <div class="stat-box gsap-reveal">
        <div class="flex items-center justify-center gap-1">
          <span class="stat-number stat-count" data-target="12">12</span>
          <span class="stat-number">+</span>
        </div>
        <p class="text-xs sm:text-sm font-semibold text-[#5A6A85] uppercase tracking-wider mt-2">
          <span class="lang-text" data-en="Years of Clinical Experience" data-bn="বছরের ক্লিনিক্যাল অভিজ্ঞতা">বছরের ক্লিনিক্যাল অভিজ্ঞতা</span>
        </p>
        <p class="text-xs text-[#5A6A85]/80 mt-1">
          <span class="lang-text" data-en="33rd BCS Health & Academic Hospitals" data-bn="৩৩তম বিসিএস ও সরকারি মেডিকেল কলেজ">৩৩তম বিসিএস ও সরকারি মেডিকেল কলেজ</span>
        </p>
      </div>

      <!-- Stat 2: Publications -->
      <div class="stat-box gsap-reveal">
        <div class="flex items-center justify-center">
          <span class="stat-number stat-count" data-target="13">13</span>
        </div>
        <p class="text-xs sm:text-sm font-semibold text-[#5A6A85] uppercase tracking-wider mt-2">
          <span class="lang-text" data-en="Publications Listed in CV" data-bn="গবেষণা ও প্রকাশনা">গবেষণা ও প্রকাশনা</span>
        </p>
        <p class="text-xs text-[#5A6A85]/80 mt-1">
          <span class="lang-text" data-en="Thoracic surgery, lobectomy, and critical care" data-bn="বক্ষ সার্জারি, লোবেকটোমি ও ক্রিটিক্যাল কেয়ার">বক্ষ সার্জারি, লোবেকটোমি ও ক্রিটিক্যাল কেয়ার</span>
        </p>
      </div>

      <!-- Stat 3: Chambers -->
      <div class="stat-box gsap-reveal">
        <div class="flex items-center justify-center">
          <span class="stat-number stat-count" data-target="2">2</span>
        </div>
        <p class="text-xs sm:text-sm font-semibold text-[#5A6A85] uppercase tracking-wider mt-2">
          <span class="lang-text" data-en="Active Chamber Locations" data-bn="রোগী দেখার চেম্বার">রোগী দেখার চেম্বার</span>
        </p>
        <p class="text-xs text-[#5A6A85]/80 mt-1">
          <span class="lang-text" data-en="Faridpur & Madaripur Districts" data-bn="ফরিদপুর ও মাদারীপুর জেলা">ফরিদপুর ও মাদারীপুর জেলা</span>
        </p>
      </div>

    </div>
  </div>
</section>

<!-- ==========================================
     SPECIALTIES & CONDITIONS SPOTLIGHT
     ========================================== -->
<section class="py-16 bg-[#FAFCFF]" aria-labelledby="specialties-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[#1677D2] text-xs font-bold uppercase tracking-widest px-3 py-1 bg-blue-50 rounded-full border border-blue-100">
        <span class="lang-text" data-en="Clinical Expertise" data-bn="বিশেষজ্ঞ চিকিৎসাসমূহ">বিশেষজ্ঞ চিকিৎসাসমূহ</span>
      </span>
      <h2 id="specialties-heading" class="text-2xl sm:text-4xl font-extrabold text-[#071B49] mt-3">
        <span class="lang-text" data-en="Chest & Respiratory Conditions Managed" data-bn="ফুসফুস ও বক্ষব্যাধির আধুনিক চিকিৎসা">ফুসফুস ও বক্ষব্যাধির আধুনিক চিকিৎসা</span>
      </h2>
      <p class="text-sm sm:text-base text-[#5A6A85] mt-2">
        <span class="lang-text" 
          data-en="Evidence-based surgical and medical pulmonology evaluations for acute and chronic conditions." 
          data-bn="ফুসফুস ও শ্বাসনালীর যেকোনো জটিল সমস্যার আন্তর্জাতিক মানসম্মত রোগ নির্ণয় ও অস্ত্রোপচার।">
          ফুসফুস ও শ্বাসনালীর যেকোনো জটিল সমস্যার আন্তর্জাতিক মানসম্মত রোগ নির্ণয় ও অস্ত্রোপচার।
        </span>
      </p>
    </div>

    <!-- Specialties Grid (First 6 Highlights) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% specialties.slice(0, 6).forEach((item) => { %>
        <div class="med-card gsap-reveal flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#1677D2]/10 to-[#25C5E8]/10 text-[#1677D2] flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <h3 class="font-bold text-lg text-[#071B49] mb-2">
              <span class="lang-text" data-en="<%= item.nameEn %>" data-bn="<%= item.nameBn %>"><%= item.nameBn %></span>
            </h3>
            <p class="text-sm text-[#5A6A85] leading-relaxed">
              <span class="lang-text" data-en="<%= item.descriptionEn %>" data-bn="<%= item.descriptionBn %>"><%= item.descriptionBn %></span>
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-semibold text-[#1677D2]">
            <a href="/expertise#<%= item.id %>" class="hover:underline flex items-center gap-1">
              <span class="lang-text" data-en="Learn More" data-bn="বিস্তারিত জানুন">বিস্তারিত জানুন</span>
              <span>›</span>
            </a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- View All Specialties CTA -->
    <div class="text-center mt-10">
      <a href="/expertise" class="btn-secondary-outline text-sm font-bold px-6 py-3">
        <span class="lang-text" data-en="View All 15 Conditions & Procedures" data-bn="সকল ১৫টি চিকিৎসা ও সার্জারি পদ্ধতি দেখুন">সকল ১৫টি চিকিৎসা ও সার্জারি পদ্ধতি দেখুন</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- ==========================================
     CHAMBER & VISITING HOURS SECTION
     ========================================== -->
<section id="chambers" class="py-16 bg-[#F1F5FA] border-y border-[#E2E8F0]" aria-labelledby="chambers-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[#13A89E] text-xs font-bold uppercase tracking-widest px-3 py-1 bg-teal-50 rounded-full border border-teal-100">
        <span class="lang-text" data-en="Visiting Hours & Locations" data-bn="চেম্বার ও সময়সূচি">চেম্বার ও সময়সূচি</span>
      </span>
      <h2 id="chambers-heading" class="text-2xl sm:text-4xl font-extrabold text-[#071B49] mt-3">
        <span class="lang-text" data-en="Chambers & Visiting Hours" data-bn="চেম্বার ও রোগী দেখার সময়সূচি">চেম্বার ও রোগী দেখার সময়সূচি</span>
      </h2>
      <p class="text-sm sm:text-base text-[#5A6A85] mt-2">
        <span class="lang-text" 
          data-en="Patients can consult Dr. Karmakar directly at the designated hospital chambers in Faridpur and Madaripur." 
          data-bn="ফরিদপুর ও মাদারীপুর চেম্বারে নিয়মিত রোগী দেখা হয়। সুবিধাজনক চেম্বার বেছে নিয়ে সিরিয়াল নিন।">
          ফরিদপুর ও মাদারীপুর চেম্বারে নিয়মিত রোগী দেখা হয়। সুবিধাজনক চেম্বার বেছে নিয়ে সিরিয়াল নিন।
        </span>
      </p>
    </div>

    <!-- 2 Chamber Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <% chambers.forEach((ch, idx) => { %>
        <div class="chamber-card gsap-reveal">
          
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <span class="chamber-badge mb-2">
                <svg class="w-3.5 h-3.5 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                <span>Chamber <%= idx + 1 %></span>
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-[#071B49]">
                <span class="lang-text" data-en="<%= ch.hospitalEn %>" data-bn="<%= ch.hospitalBn %>"><%= ch.hospitalBn %></span>
              </h3>
            </div>
            
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1677D2] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
          </div>

          <!-- Location Address -->
          <div class="space-y-3 mb-6 flex-grow">
            <p class="text-sm text-[#5A6A85] flex items-start gap-2.5">
              <svg class="w-4 h-4 text-[#1677D2] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
              </svg>
              <span class="lang-text" data-en="<%= ch.locationEn %>" data-bn="<%= ch.locationBn %>"><%= ch.locationBn %></span>
            </p>

            <!-- Visiting Schedule Highlight -->
            <div class="p-3.5 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0] space-y-1.5">
              <div class="flex items-center gap-2 text-sm font-bold text-[#071B49]">
                <svg class="w-4 h-4 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span class="lang-text" data-en="<%= ch.visitingDayEn %>" data-bn="<%= ch.visitingDayBn %>"><%= ch.visitingDayBn %></span>
              </div>
              <div class="flex items-center gap-2 text-sm font-semibold text-[#13A89E] pl-6">
                <svg class="w-4 h-4 text-[#13A89E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="lang-text" data-en="<%= ch.visitingTimeEn %>" data-bn="<%= ch.visitingTimeBn %>"><%= ch.visitingTimeBn %></span>
              </div>
            </div>

            <!-- Note -->
            <% if (ch.notesEn) { %>
              <p class="text-xs text-[#5A6A85] italic">
                <span class="lang-text" data-en="* <%= ch.notesEn %>" data-bn="* <%= ch.notesBn %>">* <%= ch.notesBn %></span>
              </p>
            <% } %>
          </div>

          <!-- Chamber Action Buttons -->
          <div class="pt-4 border-t border-[#E2E8F0] grid grid-cols-2 sm:grid-cols-4 gap-2">
            <a href="tel:<%= ch.appointmentPhone %>" class="btn-primary-gradient text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1.5 rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span class="lang-text" data-en="Call Serial" data-bn="সিরিয়াল কল">সিরিয়াল কল</span>
            </a>

            <a href="https://wa.me/<%= ch.whatsappNumber %>?text=<%= encodeURIComponent('হ্যালো, আমি ' + ch.hospitalBn + ' চেম্বারে ডা. রাজীবশঙ্কর কর্মকারের সিরিয়ালের জন্য যোগাযোগ করছি।') %>" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1.5 rounded-lg border-teal-500 text-teal-700 hover:bg-teal-50">
              <svg class="w-3.5 h-3.5 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.969.585 1.961.948 3.226.949h.005c3.18 0 5.768-2.586 5.769-5.767.001-1.542-.599-2.991-1.688-4.081-1.09-1.09-2.539-1.69-4.08-1.69zm8.563 5.768c-.002 4.71-3.834 8.541-8.547 8.541-1.442 0-2.85-.365-4.1-1.057l-4.57 1.198 1.22-4.453c-.76-1.321-1.161-2.827-1.16-4.229.002-4.711 3.834-8.542 8.548-8.542 2.283.001 4.43 1.033 6.044 2.648 1.615 1.616 2.503 3.762 2.501 6.044z"/>
              </svg>
              <span>WhatsApp</span>
            </a>

            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(ch.googleMapsQuery) %>" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-xs font-semibold py-2.5 px-3 flex items-center justify-center gap-1 rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              <span class="lang-text" data-en="Map" data-bn="ম্যাপ">ম্যাপ</span>
            </a>

            <a href="#appointment" onclick="document.getElementById('preferred-chamber').value = '<%= ch.hospitalEn %>';" class="btn-cyan-accent text-xs font-semibold py-2.5 px-3 flex items-center justify-center rounded-lg">
              <span class="lang-text" data-en="Book" data-bn="বুকিং">বুকিং</span>
            </a>
          </div>

        </div>
      <% }); %>
    </div>

  </div>
</section>

<!-- ==========================================
     APPOINTMENT REQUEST FORM SECTION
     ========================================== -->
<section id="appointment" class="py-16 bg-white" aria-labelledby="appointment-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-[#1677D2] text-xs font-bold uppercase tracking-widest px-3 py-1 bg-blue-50 rounded-full border border-blue-100">
        <span class="lang-text" data-en="Chamber Serial Request" data-bn="চেম্বার সিরিয়াল বুকিং">চেম্বার সিরিয়াল বুকিং</span>
      </span>
      <h2 id="appointment-heading" class="text-2xl sm:text-4xl font-extrabold text-[#071B49] mt-3">
        <span class="lang-text" data-en="Request an Appointment" data-bn="অ্যাপয়েন্টমেন্টের আবেদন করুন">অ্যাপয়েন্টমেন্টের আবেদন করুন</span>
      </h2>
      <p class="text-sm sm:text-base text-[#5A6A85] mt-2">
        <span class="lang-text" 
          data-en="Fill in your details below. Your request will be formatted for WhatsApp and sent to the doctor’s chamber assistant for confirmation." 
          data-bn="নিচের ফর্মটি পূরণ করুন। আপনার অনুরোধটি স্বয়ংক্রিয়ভাবে হোয়াটসঅ্যাপে প্রস্তুত হয়ে চেম্বার সহকারীর কাছে প্রেরিত হবে।">
          নিচের ফর্মটি পূরণ করুন। আপনার অনুরোধটি স্বয়ংক্রিয়ভাবে হোয়াটসঅ্যাপে প্রস্তুত হয়ে চেম্বার সহকারীর কাছে প্রেরিত হবে।
        </span>
      </p>
    </div>

    <!-- Interactive Form Card -->
    <div class="med-card shadow-lg p-6 sm:p-10 border-[#CBD5E1]">
      
      <div id="form-alert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium" role="alert"></div>

      <form id="appointment-form" novalidate>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          
          <!-- Patient Name -->
          <div class="form-group">
            <label for="patient-name" class="form-label">
              <span class="lang-text" data-en="Patient Full Name *" data-bn="রোগীর পুরো নাম *">রোগীর পুরো নাম *</span>
            </label>
            <input 
              type="text" 
              id="patient-name" 
              name="patientName" 
              class="form-input" 
              placeholder="রোগীর নাম লিখুন" 
              data-placeholder-en="Enter patient full name" 
              data-placeholder-bn="রোগীর নাম লিখুন"
              required 
            />
            <p id="patient-name-error" class="form-error"></p>
          </div>

          <!-- Contact Phone -->
          <div class="form-group">
            <label for="patient-phone" class="form-label">
              <span class="lang-text" data-en="Mobile Number (11 Digits) *" data-bn="মোবাইল নম্বর (১১ ডিজিট) *">মোবাইল নম্বর (১১ ডিজিট) *</span>
            </label>
            <input 
              type="tel" 
              id="patient-phone" 
              name="patientPhone" 
              class="form-input" 
              placeholder="০১৭১XXXXXXXX" 
              data-placeholder-en="e.g. 017XXXXXXXX" 
              data-placeholder-bn="০১৭১XXXXXXXX"
              required 
            />
            <p id="patient-phone-error" class="form-error"></p>
          </div>

          <!-- Preferred Chamber -->
          <div class="form-group sm:col-span-2">
            <label for="preferred-chamber" class="form-label">
              <span class="lang-text" data-en="Select Preferred Chamber *" data-bn="পছন্দের চেম্বার নির্বাচন করুন *">পছন্দের চেম্বার নির্বাচন করুন *</span>
            </label>
            <select id="preferred-chamber" name="preferredChamber" class="form-select" required>
              <option value="" disabled selected>-- চেম্বার নির্বাচন করুন / Select Chamber --</option>
              <option value="Southern General Hospital (Faridpur)">সাউদার্ন জেনারেল হাসপাতাল, ফরিদপুর (বৃহস্পতিবার ৩:০০ - ৫:০০ টা)</option>
              <option value="Probashi Hospital (Madaripur)">প্রবাসী হাসপাতাল, টেকেরহাট, মাদারীপুর (শুক্রবার ১০:০০ - ৩:০০ টা)</option>
              <option value="Online Consultation Inquiries">অনলাইন চিকিৎসা পরামর্শ / Online Consultation</option>
            </select>
            <p id="preferred-chamber-error" class="form-error"></p>
          </div>

          <!-- Preferred Date -->
          <div class="form-group">
            <label for="preferred-date" class="form-label">
              <span class="lang-text" data-en="Preferred Date" data-bn="সম্ভাব্য তারিখ">সম্ভাব্য তারিখ</span>
            </label>
            <input type="date" id="preferred-date" name="preferredDate" class="form-input" />
          </div>

          <!-- Preferred Time -->
          <div class="form-group">
            <label for="preferred-time" class="form-label">
              <span class="lang-text" data-en="Preferred Time Slot" data-bn="পছন্দের সময়">পছন্দের সময়</span>
            </label>
            <select id="preferred-time" name="preferredTime" class="form-select">
              <option value="As per Chamber Schedule">চেম্বারের শিডিউল অনুযায়ী / As per Schedule</option>
              <option value="Morning (সকাল)">Morning (সকাল)</option>
              <option value="Afternoon (দুপুর)">Afternoon (দুপুর)</option>
              <option value="Evening (বিকেল/সন্ধ্যা)">Evening (বিকেল/সন্ধ্যা)</option>
            </select>
          </div>

          <!-- Health Problem / Symptoms -->
          <div class="form-group sm:col-span-2">
            <label for="visit-reason" class="form-label">
              <span class="lang-text" data-en="Health Problem or Symptoms *" data-bn="রোগের প্রধান সমস্যা বা লক্ষণসমূহ *">রোগের প্রধান সমস্যা বা লক্ষণসমূহ *</span>
            </label>
            <textarea 
              id="visit-reason" 
              name="visitReason" 
              rows="3" 
              class="form-textarea" 
              placeholder="যেমন: কাশি, শ্বাসকষ্ট, বুকে ব্যথা, সিটি স্ক্যান বা এক্স-রে রিপোর্ট পর্যালোচনা" 
              data-placeholder-en="e.g. chronic cough, shortness of breath, chest pain, CT scan/X-ray review" 
              data-placeholder-bn="যেমন: কাশি, শ্বাসকষ্ট, বুকে ব্যথা, সিটি স্ক্যান বা এক্স-রে রিপোর্ট পর্যালোচনা"
              required></textarea>
            <p id="visit-reason-error" class="form-error"></p>
          </div>

          <!-- Additional Notes -->
          <div class="form-group sm:col-span-2">
            <label for="additional-notes" class="form-label">
              <span class="lang-text" data-en="Additional Notes (Optional)" data-bn="অতিরিক্ত কোনো তথ্য (ঐচ্ছিক)">অতিরিক্ত কোনো তথ্য (ঐচ্ছিক)</span>
            </label>
            <input 
              type="text" 
              id="additional-notes" 
              name="additionalNotes" 
              class="form-input" 
              placeholder="পূর্বের কোনো অপারেশন বা বিশেষ কোনো জরুরি তথ্য থাকলে লিখুন" 
              data-placeholder-en="Any previous surgeries, allergies, or questions" 
              data-placeholder-bn="পূর্বের কোনো অপারেশন বা বিশেষ কোনো জরুরি তথ্য থাকলে লিখুন"
            />
          </div>

        </div>

        <!-- Submit Button -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <button type="submit" id="submit-appointment-btn" class="btn-primary-gradient w-full sm:w-auto px-8 py-3.5 text-base font-bold shadow-lg flex items-center justify-center gap-2">
            <svg id="submit-btn-spinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="submit-btn-text" class="lang-text" data-en="Send Request via WhatsApp" data-bn="হোয়াটসঅ্যাপে সিরিয়াল পাঠান">হোয়াটসঅ্যাপে সিরিয়াল পাঠান</span>
          </button>

          <a href="tel:01944648809" class="text-xs sm:text-sm text-[#5A6A85] hover:text-[#1677D2] font-semibold flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#1677D2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span class="lang-text" data-en="Or Call Serial Directly: 01944648809" data-bn="অথবা সরাসরি কল করুন: ০১৯৪৪৬৪৮৮০৯">অথবা সরাসরি কল করুন: ০১৯৪৪৬৪৮৮০৯</span>
          </a>
        </div>

      </form>

    </div>

  </div>
</section>

<!-- ==========================================
     ONLINE CONSULTATION INFO
     ========================================== -->
<section class="py-14 bg-[#FAFCFF] border-b border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="med-card bg-gradient-to-br from-[#071B49] to-[#0f2b6b] text-white p-8 sm:p-12 rounded-3xl border-none shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#25C5E8] text-xs font-semibold">
            <span class="lang-text" data-en="Remote Assistance" data-bn="দূরবর্তী স্বাস্থ্য পরামর্শ">দূরবর্তী স্বাস্থ্য পরামর্শ</span>
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            <span class="lang-text" data-en="Online Consultation & Report Review" data-bn="অনলাইনে চিকিৎসা পরামর্শ ও রিপোর্ট পর্যালোচনা">অনলাইনে চিকিৎসা পরামর্শ ও রিপোর্ট পর্যালোচনা</span>
          </h3>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed">
            <span class="lang-text" 
              data-en="For preliminary inquiries, second opinions on thoracic surgery, or follow-up report assessments, patients may connect via WhatsApp. Availability and scheduling must be confirmed with the doctor or chamber assistant." 
              data-bn="দূরদূরান্তের রোগী বা ফলো-আপ টেস্টের রিপোর্ট দেখানোর জন্য হোয়াটসঅ্যাপের মাধ্যমে যোগাযোগ করতে পারেন। সময় ও সুযোগ সাপেক্ষে চেম্বার সহকারী বা ডাক্তার পরামর্শের সময় নিশ্চিত করবেন।">
              দূরদূরান্তের রোগী বা ফলো-আপ টেস্টের রিপোর্ট দেখানোর জন্য হোয়াটসঅ্যাপের মাধ্যমে যোগাযোগ করতে পারেন। সময় ও সুযোগ সাপেক্ষে চেম্বার সহকারী বা ডাক্তার পরামর্শের সময় নিশ্চিত করবেন।
            </span>
          </p>
