            <span class="lang-text" data-en="<%= faq.questionEn %>" data-bn="<%= faq.questionBn %>"><%= faq.questionBn %></span>
            <svg class="faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="faq-desc-<%= faq.id %>" class="faq-content">
            <p class="lang-text" data-en="<%= faq.answerEn %>" data-bn="<%= faq.answerBn %>"><%= faq.answerBn %></p>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

