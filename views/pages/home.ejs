        </span>
        <h2 id="pubs-spotlight-heading" class="text-2xl sm:text-3xl font-extrabold text-[#071B49] mt-3">
          <span class="lang-text" data-en="Recent Research & Scientific Publications" data-bn="সাম্প্রতিক বৈজ্ঞানিক গবেষণা ও জার্নাল পেপার">সাম্প্রতিক বৈজ্ঞানিক গবেষণা ও জার্নাল পেপার</span>
        </h2>
      </div>

      <a href="/publications" class="btn-secondary-outline text-xs sm:text-sm font-bold py-2.5 px-4 self-start md:self-auto flex items-center gap-1.5">
        <span class="lang-text" data-en="View All 13 Publications" data-bn="সকল ১৩টি গবেষণাপত্র দেখুন">সকল ১৩টি গবেষণাপত্র দেখুন</span>
        <span>›</span>
      </a>
    </div>

    <!-- Publications List -->
    <div class="space-y-4">
      <% publications.forEach((pub) => { %>
        <article class="pub-card gsap-reveal flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1.5 max-w-3xl">
            <div class="flex items-center gap-2">
              <span class="pub-badge"><%= pub.year %></span>
              <span class="text-xs font-semibold text-[#1677D2]"><%= pub.journal %></span>
              <% if (pub.volume) { %>
                <span class="text-xs text-[#5A6A85]"><%= pub.volume %></span>
              <% } %>
            </div>
            <h3 class="font-bold text-base text-[#071B49]">
              <%= pub.title %>
            </h3>
            <% if (pub.doi) { %>
              <p class="text-xs text-[#5A6A85] font-mono">
                DOI: <%= pub.doi %>
              </p>
            <% } %>
          </div>

          <% if (pub.doiUrl) { %>
            <div class="flex-shrink-0">
              <a href="<%= pub.doiUrl %>" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline text-xs py-2 px-3.5 inline-flex items-center gap-1">
                <span>View DOI</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          <% } %>
        </article>
      <% }); %>
    </div>

  </div>
</section>

