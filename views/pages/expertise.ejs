<!-- ==========================================
     PAGE HEADER
     ========================================== -->
<div class="bg-[#071B49] text-white py-12 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2 text-xs text-[#25C5E8] mb-3">
      <a href="/" class="hover:underline">Home / মূলপাতা</a>
      <span>/</span>
      <span class="text-white">Expertise / চিকিৎসা ও সার্জারি</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
      <span class="lang-text" data-en="Medical Expertise & Surgical Procedures" data-bn="বক্ষব্যাধির চিকিৎসা ও সার্জিক্যাল সেবা">বক্ষব্যাধির চিকিৎসা ও সার্জিক্যাল সেবা</span>
    </h1>
    <p class="text-sm sm:text-base text-white/80 mt-2 max-w-3xl">
      <span class="lang-text" 
        data-en="Specialized clinical evaluations and state-of-the-art thoracic & oesophageal surgical interventions by Dr. Rajeeebshankar Karmakar." 
        data-bn="ফুসফুস, বক্ষপিঞ্জর ও খাদ্যনালীর জটিল রোগসমূহের আধুনিক চিকিৎসা ও বিশেষজ্ঞ সার্জিক্যাল পদ্ধতিসমূহ।">
        ফুসফুস, বক্ষপিঞ্জর ও খাদ্যনালীর জটিল রোগসমূহের আধুনিক চিকিৎসা ও বিশেষজ্ঞ সার্জিক্যাল পদ্ধতিসমূহ।
      </span>
    </p>
  </div>
</div>

<!-- ==========================================
     EMERGENCY NOTICE
     ========================================== -->
<div class="bg-red-50 border-b border-red-200 py-3.5 px-4 text-xs sm:text-sm text-red-900">
  <div class="max-w-7xl mx-auto flex items-center gap-3">
    <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <p>
      <strong><span class="lang-text" data-en="Clinical Disclaimer:" data-bn="জরুরি সতর্কতা:">জরুরি সতর্কতা:</span></strong>
      <span class="lang-text" 
        data-en="Not all respiratory symptoms require surgical intervention. In cases of acute crushing chest pain, massive hemoptysis, or severe acute shortness of breath, please immediately visit a hospital emergency department." 
        data-bn="সকল কাশির জন্য অস্ত্রোপচারের প্রয়োজন নেই। যদি রোগীর হঠাৎ তীব্র শ্বাসকষ্ট, কাশির সাথে অতিরিক্ত রক্তক্ষরণ বা তীব্র বুকে ব্যথা অনুভূত হয়, তবে অনলাইন অ্যাপয়েন্টমেন্টের অপেক্ষা না করে অবিলম্বে নিকটস্থ হাসপাতালের জরুরি বিভাগে যোগাযোগ করুন।">
        সকল কাশির জন্য অস্ত্রোপচারের প্রয়োজন নেই। যদি রোগীর হঠাৎ তীব্র শ্বাসকষ্ট, কাশির সাথে অতিরিক্ত রক্তক্ষরণ বা তীব্র বুকে ব্যথা অনুভূত হয়, তবে অনলাইন অ্যাপয়েন্টমেন্টের অপেক্ষা না করে অবিলম্বে নিকটস্থ হাসপাতালের জরুরি বিভাগে যোগাযোগ করুন।
      </span>
    </p>
  </div>
</div>

<!-- ==========================================
     15 CONDITIONS TREATED
     ========================================== -->
<section class="py-16 bg-[#FAFCFF] border-b border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[#1677D2] text-xs font-bold uppercase tracking-widest px-3 py-1 bg-blue-50 rounded-full border border-blue-100">
        <span class="lang-text" data-en="Conditions Managed" data-bn="যেসব রোগের চিকিৎসা দেওয়া হয়">যেসব রোগের চিকিৎসা দেওয়া হয়</span>
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#071B49] mt-3">
        <span class="lang-text" data-en="Chest, Lung & Oesophageal Conditions" data-bn="ফুসফুস, বক্ষ ও খাদ্যনালীর জটিল রোগসমূহ">ফুসফুস, বক্ষ ও খাদ্যনালীর জটিল রোগসমূহ</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% specialties.forEach((sp) => { %>
        <div id="<%= sp.id %>" class="med-card flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1677D2] flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            
            <h3 class="font-bold text-lg text-[#071B49] mb-2">
              <span class="lang-text" data-en="<%= sp.nameEn %>" data-bn="<%= sp.nameBn %>"><%= sp.nameBn %></span>
            </h3>

            <p class="text-xs sm:text-sm text-[#5A6A85] leading-relaxed">
              <span class="lang-text" data-en="<%= sp.descriptionEn %>" data-bn="<%= sp.descriptionBn %>"><%= sp.descriptionBn %></span>
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-semibold text-[#1677D2]">
            <a href="/contact#appointment" class="hover:underline flex items-center gap-1">
              <span class="lang-text" data-en="Consult Doctor" data-bn="পরামর্শ নিন">পরামর্শ নিন</span>
              <span>›</span>
            </a>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

<!-- ==========================================
     SURGICAL & CLINICAL PROCEDURES
     ========================================== -->
<section class="py-16 bg-white border-b border-[#E2E8F0]" aria-labelledby="procedures-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[#13A89E] text-xs font-bold uppercase tracking-widest px-3 py-1 bg-teal-50 rounded-full border border-teal-100">
        <span class="lang-text" data-en="Clinical Competencies" data-bn="সার্জিক্যাল পদ্ধতি">সার্জিক্যাল পদ্ধতি</span>
      </span>
      <h2 id="procedures-heading" class="text-2xl sm:text-3xl font-extrabold text-[#071B49] mt-3">
        <span class="lang-text" data-en="Surgical & Interventional Procedures" data-bn="আধুনিক অস্ত্রোপচার ও ইন্টারভেনশনসমূহ">আধুনিক অস্ত্রোপচার ও ইন্টারভেনশনসমূহ</span>
      </h2>
      <p class="text-xs sm:text-sm text-[#5A6A85] mt-2 max-w-2xl mx-auto">
        <span class="lang-text" 
          data-en="Procedures are offered strictly when clinically indicated following thorough diagnostic evaluation. Procedures are scheduled at appropriate tertiary hospital surgical facilities." 
          data-bn="রোগীর প্রয়োজনীয় সকল টেস্ট ও শারীরিক পরীক্ষা শেষে ক্লিনিক্যাল প্রয়োজনীয়তা বিবেচনা করে উপযুক্ত হাসপাতালে অস্ত্রোপচারের ব্যবস্থা করা হয়।">
          রোগীর প্রয়োজনীয় সকল টেস্ট ও শারীরিক পরীক্ষা শেষে ক্লিনিক্যাল প্রয়োজনীয়তা বিবেচনা করে উপযুক্ত হাসপাতালে অস্ত্রোপচারের ব্যবস্থা করা হয়।
        </span>
      </p>
    </div>

    <!-- Categorized Procedures -->
    <div class="space-y-8 max-w-5xl mx-auto">
      <% procedures.forEach((cat) => { %>
        <div class="med-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-4 border-b border-[#E2E8F0] pb-3">
            <div class="w-8 h-8 rounded-lg bg-[#1677D2] text-white flex items-center justify-center font-bold text-xs">
              ✓
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-[#071B49]">
              <span class="lang-text" data-en="<%= cat.categoryEn %>" data-bn="<%= cat.categoryBn %>"><%= cat.categoryBn %></span>
            </h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% cat.items.forEach((item) => { %>
              <div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-[#F8FAFC]">
                <svg class="w-4 h-4 text-[#25C5E8] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <div class="text-xs sm:text-sm text-[#071B49] font-medium">
                  <p class="lang-text" data-en="<%= item.nameEn %>" data-bn="<%= item.nameBn %>"><%= item.nameBn %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

<!-- ==========================================
     CTA BANNER
     ========================================== -->
<section class="py-14 bg-[#FAFCFF]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-[#071B49] to-[#1677D2] text-white shadow-xl">
      <h3 class="text-2xl sm:text-3xl font-extrabold mb-3">
        <span class="lang-text" data-en="Need Clinical Guidance or Second Opinion?" data-bn="বক্ষ সার্জারি বা ফুসফুসের চিকিৎসার পরামর্শ প্রয়োজন?">বক্ষ সার্জারি বা ফুসফুসের চিকিৎসার পরামর্শ প্রয়োজন?</span>
      </h3>
      <p class="text-white/80 text-sm max-w-xl mx-auto mb-6">
        <span class="lang-text" 
          data-en="Reach out to discuss your medical condition, test reports, or schedule a chamber visit." 
          data-bn="রোগের লক্ষণ, সিটি স্ক্যান বা এক্স-রে রিপোর্ট নিয়ে সরাসরি পরামর্শের জন্য আজই যোগাযোগ করুন।">
          রোগের লক্ষণ, সিটি স্ক্যান বা এক্স-রে রিপোর্ট নিয়ে সরাসরি পরামর্শের জন্য আজই যোগাযোগ করুন।
        </span>
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/contact#appointment" class="btn-cyan-accent text-sm font-bold px-6 py-3">
          <span class="lang-text" data-en="Book Serial Now" data-bn="সিরিয়াল বুক করুন">সিরিয়াল বুক করুন</span>
        </a>
        <a href="tel:01944648809" class="btn-white-outline text-sm font-semibold px-6 py-3">
          <span>Call 01944648809</span>
        </a>
      </div>
    </div>
  </div>
</section>
